<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <meta name="description" content="Login to RailEase – India's premier railway reservation platform."/>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
  <style>
    body { margin: 0; background: var(--surface); }
    .login-grid { display: grid; grid-template-columns: 7fr 5fr; min-height: 100vh; }
    @media (max-width: 900px) { .login-grid { grid-template-columns: 1fr; } .left-panel { display: none; } }
    .left-panel {
      background: var(--surface-container-low);
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 3rem 4rem;
      overflow: hidden;
    }
    .left-panel .bg-img {
      position: absolute; inset: 0;
      background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCj1zmViQwGqWVjVR_dUzo99nOGSBNwVe6XhWbotQycgzq9VFvupvfCNkP3DLpoFjJUXYjMLHO1tFaYirnk0DiWW-4wy2aCm24mY4or8b0SUP6ga9Zd_-b7EcvKlNglsNmv0ppHO5rbF9bouZU3zNO6wEVl7yr_PSXNhIGsZnRKGnSfuYuwM7edzByCAFKJtkWMgh9pIbebA_xit0BhGLvGvyLtnd8nIgyFzwX53qWq');
      background-size: cover; background-position: center;
      opacity: 0.15; mix-blend-mode: multiply;
    }
    .left-panel .gradient-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top right, var(--surface-container-low), transparent, rgba(9,76,178,0.08));
    }
    .right-panel {
      background: var(--surface-container-lowest);
      display: flex; align-items: center; justify-content: center;
      padding: 3rem 2rem;
    }
    .login-card { width: 100%; max-width: 420px; }
    .stat-item { text-align: left; }
    .stat-item .num { font-family: 'Noto Serif', serif; font-size: 1.6rem; font-weight: 700; color: var(--on-surface); }
    .stat-item .lbl { font-family: 'Public Sans', sans-serif; font-size: 0.65rem; color: var(--on-surface-variant); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 2px; }
    .stats-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(195,198,213,0.2); }
    .train-icon-box { width: 52px; height: 52px; border-radius: 12px; background: var(--primary-fixed); display: flex; align-items: center; justify-content: center; color: var(--primary); margin-bottom: 1.5rem; }
  </style>
</head>
<body>
<div class="login-grid">
  <!-- Left Panel -->
  <div class="left-panel">
    <div class="bg-img"></div>
    <div class="gradient-overlay"></div>

    <!-- Top badge -->
    <div style="position:relative; z-index:10; display:flex; align-items:center; justify-content:space-between;">
      <div style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.5rem 1rem; border-radius:999px; background:rgba(227,226,227,0.85); backdrop-filter:blur(16px);">
        <span class="material-symbols-outlined" style="color:var(--primary); font-size:18px;">verified</span>
        <span style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--on-surface-variant); font-weight:700;">Secure Portal v4.2</span>
      </div>
      <span style="font-family:'Noto Serif',serif; font-style:italic; color:var(--on-surface-variant); font-size:0.85rem;">Est. 2024</span>
    </div>

    <!-- Center content -->
    <div style="position:relative; z-index:10; margin:auto 0; padding:3rem 0; max-width:520px;">
      <span style="font-family:'Public Sans',sans-serif; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--primary); font-weight:700; display:block; margin-bottom:0.75rem;">Transcontinental Transit</span>
      <h1 class="font-headline" style="font-size:3.5rem; line-height:1.08; color:var(--on-surface); font-weight:400; margin-bottom:1.5rem;">
        The art of seamless railway journey curation.
      </h1>
      <p style="color:var(--on-surface-variant); font-size:1rem; line-height:1.7; margin-bottom:2rem;">
        Access your digital sleeper compartments, priority boarding passes, and bespoke itinerary archives with absolute security and unprecedented speed.
      </p>
      <div class="stats-row">
        <div class="stat-item"><div class="num">99.4%</div><div class="lbl">On-Time Index</div></div>
        <div class="stat-item"><div class="num">1,400+</div><div class="lbl">Global Routes</div></div>
        <div class="stat-item"><div class="num">256-Bit</div><div class="lbl">Encrypted Auth</div></div>
      </div>
    </div>

    <!-- Bottom footer -->
    <div style="position:relative; z-index:10; display:flex; align-items:center; justify-content:space-between; font-family:'Public Sans',sans-serif; font-size:0.72rem; color:var(--on-surface-variant);">
      <span>© RailEase Systems International</span>
      <div style="display:flex; gap:1.5rem;">
        <a href="#" style="color:inherit; text-decoration:none; transition:color 0.2s;" onmouseover="this.style.color='#094cb2'" onmouseout="this.style.color=''">Privacy Codex</a>
        <a href="#" style="color:inherit; text-decoration:none; transition:color 0.2s;" onmouseover="this.style.color='#094cb2'" onmouseout="this.style.color=''">Terms of Transit</a>
      </div>
    </div>
  </div>

  <!-- Right Panel: Login Form -->
  <div class="right-panel">
    <div class="login-card fade-in">
      <div class="train-icon-box">
        <span class="material-symbols-outlined" style="font-size:26px;">train</span>
      </div>
      <span style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--primary); font-weight:700; display:block; margin-bottom:0.5rem;">RailEase – Railway Reservation System</span>
      <h2 class="font-headline" style="font-size:2rem; font-weight:700; color:var(--on-surface); margin-bottom:0.35rem;">Welcome Back!</h2>
      <p style="color:var(--on-surface-variant); font-size:0.875rem; margin-bottom:2rem;">Please enter your credentials to access your traveler profile.</p>

      <!-- Flash Messages -->
      <% if (error && error.length > 0) { %>
        <div class="flash-error">
          <span class="material-symbols-outlined" style="font-size:18px;">error</span>
          <%= error[0] %>
        </div>
      <% } %>
      <% if (success && success.length > 0) { %>
        <div class="flash-success">
          <span class="material-symbols-outlined" style="font-size:18px;">check_circle</span>
          <%= success[0] %>
        </div>
      <% } %>

      <!-- Login Form -->
      <form action="/auth/login" method="POST" style="display:flex; flex-direction:column; gap:1.25rem;">
        <!-- Email -->
        <div>
          <label class="form-label">Email or Username</label>
          <div class="input-icon-wrap">
            <span class="input-icon material-symbols-outlined">mail</span>
            <input type="text" name="email" class="form-input" placeholder="traveler@railease.com" required/>
          </div>
        </div>

        <!-- Password -->
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <label class="form-label" style="margin-bottom:0;">Password</label>
            <a href="#" style="font-family:'Public Sans',sans-serif; font-size:0.72rem; font-weight:700; color:var(--primary); text-decoration:none;">Forgot Password?</a>
          </div>
          <div class="input-icon-wrap" style="position:relative;">
            <span class="input-icon material-symbols-outlined">lock</span>
            <input type="password" name="password" id="loginPassword" class="form-input" style="padding-right:3rem;" placeholder="••••••••••••" required/>
            <button type="button" onclick="togglePass('loginPassword','eyeIcon')" style="position:absolute; right:0.9rem; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:var(--outline);">
              <span class="material-symbols-outlined" id="eyeIcon" style="font-size:20px;">visibility</span>
            </button>
          </div>
        </div>

        <!-- Remember Me -->
        <label style="display:flex; align-items:center; gap:0.75rem; cursor:pointer;">
          <input type="checkbox" name="remember" style="width:16px; height:16px; accent-color:var(--primary);"/>
          <span style="font-size:0.875rem; color:var(--on-surface-variant);">Remember this device</span>
        </label>

        <!-- Submit -->
        <button type="submit" class="btn-primary" style="width:100%; justify-content:center; font-size:0.85rem; padding:1rem;">
          Access Portal
          <span class="material-symbols-outlined" style="font-size:18px;">arrow_forward</span>
        </button>
      </form>

      <!-- Divider -->
      <div style="display:flex; align-items:center; gap:1rem; margin:1.5rem 0;">
        <div style="flex:1; height:1px; background:rgba(195,198,213,0.25);"></div>
        <span style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--outline);">New to RailEase?</span>
        <div style="flex:1; height:1px; background:rgba(195,198,213,0.25);"></div>
      </div>

      <a href="/auth/signup" class="btn-secondary" style="width:100%; justify-content:center; text-decoration:none;">
        <span class="material-symbols-outlined" style="font-size:18px;">person_add</span>
        Create a New Account
      </a>

      <!-- Footer links -->
      <div style="margin-top:2.5rem; padding-top:1.5rem; border-top:1px solid rgba(195,198,213,0.2); display:flex; justify-content:center; gap:1.5rem;">
        <a href="#" style="font-family:'Public Sans',sans-serif; font-size:0.72rem; color:var(--on-surface-variant); text-decoration:none;" onmouseover="this.style.color='#094cb2'" onmouseout="this.style.color=''">Help Center</a>
        <span style="color:var(--outline-variant);">•</span>
        <a href="/bookings/pnr/check" style="font-family:'Public Sans',sans-serif; font-size:0.72rem; color:var(--on-surface-variant); text-decoration:none;" onmouseover="this.style.color='#094cb2'" onmouseout="this.style.color=''">Station Status</a>
        <span style="color:var(--outline-variant);">•</span>
        <a href="#" style="font-family:'Public Sans',sans-serif; font-size:0.72rem; color:var(--on-surface-variant); text-decoration:none;" onmouseover="this.style.color='#094cb2'" onmouseout="this.style.color=''">Security</a>
      </div>
    </div>
  </div>
</div>

<script>
  function togglePass(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }
</script>
</body>
</html>
