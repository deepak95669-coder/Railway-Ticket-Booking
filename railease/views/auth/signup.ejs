<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <meta name="description" content="Create your RailEase account – Join India's premier railway reservation platform."/>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
  <style>
    body { margin: 0; background: var(--surface); }
    .signup-grid { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }
    @media (max-width: 900px) { .signup-grid { grid-template-columns: 1fr; } .left-panel { display: none; } }
    .left-panel {
      background: var(--surface-container-low);
      position: relative; display: flex; flex-direction: column;
      justify-content: space-between; padding: 3.5rem 4rem; overflow: hidden;
    }
    .bg-img {
      position: absolute; inset: 0;
      background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAE2Sarkr3FL7K-Ywo9SzBhrBEsn_wl8KuPyjW1wSwJa3os3FbFjKqlzriW57FSZsLOziLs9T-NcN64M6kUI2KaHb3xqly7e0ede064zg-V05C6GT0pCGl_QfVj_CRb3D4GkhCQWINTHQ7MKb6fSwEq0LSETGPABLDXGhI4UijL8mQZvnV6v3BktsFJBMSN1Vh4Zu11WGUF2R5ehx00voLfRbqDEAAUDWEcXNW_j-KR');
      background-size: cover; background-position: center; opacity: 0.18;
    }
    .gradient-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top right, rgba(9,76,178,0.1), transparent, rgba(109,94,0,0.06));
    }
    .right-panel {
      background: var(--surface);
      display: flex; align-items: center; justify-content: center;
      padding: 2rem 2.5rem;
    }
    .form-card {
      width: 100%; max-width: 540px;
      background: var(--surface-container-lowest);
      border-radius: 14px;
      box-shadow: 0 24px 40px rgba(27,28,29,0.04);
      padding: 2.5rem 2.75rem;
    }
    .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  </style>
</head>
<body>
<div class="signup-grid">
  <!-- Left Panel -->
  <div class="left-panel">
    <div class="bg-img"></div>
    <div class="gradient-overlay"></div>

    <!-- Top branding -->
    <div style="position:relative; z-index:10; display:flex; align-items:center; justify-content:space-between;">
      <div style="display:flex; align-items:center; gap:0.6rem;">
        <span class="material-symbols-outlined" style="color:var(--primary); font-size:2rem; font-variation-settings:'FILL' 1;">train</span>
        <span class="font-headline" style="font-size:1.3rem; font-weight:700; color:var(--on-surface);">RailEase</span>
      </div>
      <span style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--secondary); background:var(--surface-container); padding:0.35rem 0.85rem; border-radius:999px;">Member Registry</span>
    </div>

    <!-- Center narrative -->
    <div style="position:relative; z-index:10; padding:3rem 0; max-width:460px;">
      <span style="font-family:'Public Sans',sans-serif; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--tertiary); font-weight:600; display:block; margin-bottom:1rem;">The Golden Era of Transit</span>
      <h1 class="font-headline" style="font-size:3rem; font-weight:400; color:var(--on-surface); line-height:1.12; margin-bottom:1.25rem;">
        Begin your journey across continents with unparalleled elegance.
      </h1>
      <p style="color:var(--on-surface-variant); font-size:1rem; line-height:1.7;">
        Create your RailEase profile to access priority sleeper berths, curated transcontinental itineraries, and seamless digital ticketing.
      </p>
    </div>

    <!-- Bottom -->
    <div style="position:relative; z-index:10; display:flex; align-items:center; gap:1rem;">
      <div style="width:42px; height:42px; border-radius:50%; background:var(--surface-container-high); display:flex; align-items:center; justify-content:center; font-family:'Noto Serif',serif; font-weight:700; color:var(--primary);">RE</div>
      <div>
        <p style="font-size:0.78rem; font-weight:700; color:var(--on-surface); margin-bottom:2px;">Verified Curator Network</p>
        <p style="font-family:'Public Sans',sans-serif; font-size:0.7rem; color:var(--on-surface-variant);">Over 140 luxury lines connected globally</p>
      </div>
    </div>
  </div>

  <!-- Right Panel: Sign Up Form -->
  <div class="right-panel">
    <div class="form-card fade-in">
      <h2 class="font-headline" style="font-size:1.9rem; font-weight:700; color:var(--on-surface); margin-bottom:0.35rem;">Create Account</h2>
      <p style="color:var(--on-surface-variant); font-size:0.875rem; margin-bottom:1.75rem;">Enter your credentials below to initialize your traveler registry.</p>

      <!-- Flash Messages -->
      <% if (error && error.length > 0) { %>
        <div class="flash-error">
          <span class="material-symbols-outlined" style="font-size:18px;">error</span>
          <%= error[0] %>
        </div>
      <% } %>
      <% if (success && success.length > 0) { %>
        <div class="flash-success">
          <span class="material-symbols-outlined" style="font-size:18px;">check_circle</span>
          <%= success[0] %>
        </div>
      <% } %>

      <form action="/auth/signup" method="POST" style="display:flex; flex-direction:column; gap:1.1rem;">
        <!-- Full Name -->
        <div>
          <label class="form-label">Full Name</label>
          <div class="input-icon-wrap">
            <span class="input-icon material-symbols-outlined">person</span>
            <input type="text" name="fullName" class="form-input" placeholder="Eleanor Vance" required/>
          </div>
        </div>

        <!-- Email & Mobile -->
        <div class="form-grid-2">
          <div>
            <label class="form-label">Email Address</label>
            <div class="input-icon-wrap">
              <span class="input-icon material-symbols-outlined">mail</span>
              <input type="email" name="email" class="form-input" placeholder="traveler@example.com" required/>
            </div>
          </div>
          <div>
            <label class="form-label">Mobile Number</label>
            <div class="input-icon-wrap">
              <span class="input-icon material-symbols-outlined">call</span>
              <input type="tel" name="mobile" class="form-input" placeholder="+91 98765 43210" required/>
            </div>
          </div>
        </div>

        <!-- DOB & Gender -->
        <div class="form-grid-2">
          <div>
            <label class="form-label">Date of Birth</label>
            <div class="input-icon-wrap">
              <span class="input-icon material-symbols-outlined">calendar_today</span>
              <input type="date" name="dateOfBirth" class="form-input"/>
            </div>
          </div>
          <div>
            <label class="form-label">Gender</label>
            <div class="input-icon-wrap">
              <span class="input-icon material-symbols-outlined">wc</span>
              <select name="gender" class="form-input" style="appearance:none; cursor:pointer;">
                <option value="" disabled selected>Select gender</option>
                <option value="female">Female</option>
                <option value="male">Male</option>
                <option value="non-binary">Non-binary</option>
                <option value="prefer-not">Prefer not to say</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Password & Confirm -->
        <div class="form-grid-2">
          <div>
            <label class="form-label">Password</label>
            <div class="input-icon-wrap">
              <span class="input-icon material-symbols-outlined">lock</span>
              <input type="password" name="password" class="form-input" placeholder="••••••••" required minlength="6"/>
            </div>
          </div>
          <div>
            <label class="form-label">Confirm Password</label>
            <div class="input-icon-wrap">
              <span class="input-icon material-symbols-outlined">lock_reset</span>
              <input type="password" name="confirmPassword" class="form-input" placeholder="••••••••" required/>
            </div>
          </div>
        </div>

        <!-- Terms -->
        <label style="display:flex; align-items:flex-start; gap:0.75rem; cursor:pointer;">
          <input type="checkbox" name="terms" required style="margin-top:2px; width:16px; height:16px; accent-color:var(--primary); flex-shrink:0;"/>
          <span style="font-size:0.78rem; color:var(--on-surface-variant); line-height:1.5;">
            I agree to the <a href="#" style="color:var(--primary); font-weight:700; text-decoration:none;">Terms of Service</a>,
            <a href="#" style="color:var(--primary); font-weight:700; text-decoration:none;">Privacy Policy</a>,
            and Railway Passenger Code of Conduct.
          </span>
        </label>

        <!-- Submit -->
        <button type="submit" class="btn-primary" style="width:100%; justify-content:center; margin-top:0.5rem; font-size:0.85rem; padding:1rem;">
          Create Account
          <span class="material-symbols-outlined" style="font-size:18px;">arrow_forward</span>
        </button>

        <!-- Login link -->
        <p style="text-align:center; font-size:0.875rem; color:var(--on-surface-variant); margin-top:0.5rem;">
          Already registered?
          <a href="/auth/login" style="color:var(--primary); font-weight:700; text-decoration:none;"> Return to Login</a>
        </p>
      </form>
    </div>
  </div>
</div>
</body>
</html>
