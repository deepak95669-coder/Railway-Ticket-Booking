<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
</head>
<body style="background:var(--surface);">
<%- include('partials/sidebar') %>
<div class="main-content">
  <%- include('partials/header') %>
  <main style="padding:2rem 3rem; background:var(--surface); min-height:calc(100vh - 4rem);">
    <h1 class="font-headline" style="font-size:1.8rem; font-weight:700; color:var(--on-surface); margin-bottom:0.35rem;">My Profile</h1>
    <p style="color:var(--on-surface-variant); font-size:0.875rem; margin-bottom:2rem;">Manage your personal information and account settings.</p>

    <!-- Flash -->
    <% if (success && success.length > 0) { %>
      <div class="flash-success fade-in"><span class="material-symbols-outlined" style="font-size:18px;">check_circle</span><%= success[0] %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="flash-error fade-in"><span class="material-symbols-outlined" style="font-size:18px;">error</span><%= error[0] %></div>
    <% } %>

    <div style="display:grid; grid-template-columns:1fr 2fr; gap:2rem; max-width:960px;">
      <!-- Avatar Card -->
      <div class="card fade-in" style="text-align:center; padding:2.5rem 1.5rem;">
        <div style="width:80px; height:80px; border-radius:50%; background:var(--primary); display:flex; align-items:center; justify-content:center; margin:0 auto 1.25rem;">
          <span class="material-symbols-outlined" style="color:var(--on-primary); font-size:2.5rem; font-variation-settings:'FILL' 1;">person</span>
        </div>
        <div class="font-headline" style="font-size:1.2rem; font-weight:700; color:var(--on-surface); margin-bottom:0.25rem;"><%= user.fullName %></div>
        <div style="font-size:0.8rem; color:var(--on-surface-variant); margin-bottom:0.5rem;"><%= user.email %></div>
        <div style="font-size:0.75rem; color:var(--on-surface-variant);">Member since <%= new Date(user.createdAt).toDateString() %></div>
        <div style="margin-top:1.5rem; padding-top:1.25rem; border-top:1px solid rgba(195,198,213,0.2);">
          <div style="display:flex; align-items:center; gap:0.6rem; padding:0.6rem; border-radius:8px; background:var(--primary-fixed);">
            <span class="material-symbols-outlined" style="color:var(--primary); font-size:18px;">verified</span>
            <span style="font-family:'Public Sans',sans-serif; font-size:0.72rem; color:var(--primary); font-weight:700;">Verified Traveler</span>
          </div>
        </div>
      </div>

      <!-- Edit Form -->
      <div class="card fade-in">
        <h2 class="font-headline" style="font-size:1.2rem; font-weight:700; color:var(--on-surface); margin-bottom:1.5rem;">Edit Profile</h2>
        <form action="/profile" method="POST" style="display:flex; flex-direction:column; gap:1.1rem;">
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
            <div style="grid-column:1/-1;">
              <label class="form-label">Full Name</label>
              <div class="input-icon-wrap">
                <span class="input-icon material-symbols-outlined">person</span>
                <input type="text" name="fullName" class="form-input" value="<%= user.fullName %>" required/>
              </div>
            </div>
            <div style="grid-column:1/-1;">
              <label class="form-label">Email Address (Read Only)</label>
              <div class="input-icon-wrap">
                <span class="input-icon material-symbols-outlined">mail</span>
                <input type="email" class="form-input" value="<%= user.email %>" readonly style="opacity:0.65; cursor:not-allowed;"/>
              </div>
            </div>
            <div>
              <label class="form-label">Mobile Number</label>
              <div class="input-icon-wrap">
                <span class="input-icon material-symbols-outlined">call</span>
                <input type="tel" name="mobile" class="form-input" value="<%= user.mobile || '' %>" required/>
              </div>
            </div>
            <div>
              <label class="form-label">Date of Birth</label>
              <div class="input-icon-wrap">
                <span class="input-icon material-symbols-outlined">calendar_today</span>
                <input type="date" name="dateOfBirth" class="form-input" value="<%= user.dateOfBirth ? new Date(user.dateOfBirth).toISOString().split('T')[0] : '' %>"/>
              </div>
            </div>
            <div>
              <label class="form-label">Gender</label>
              <div class="input-icon-wrap">
                <span class="input-icon material-symbols-outlined">wc</span>
                <select name="gender" class="form-input" style="appearance:none; cursor:pointer;">
                  <option value="" <%= !user.gender ? 'selected' : '' %>>Prefer not to say</option>
                  <option value="male" <%= user.gender === 'male' ? 'selected' : '' %>>Male</option>
                  <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>Female</option>
                  <option value="non-binary" <%= user.gender === 'non-binary' ? 'selected' : '' %>>Non-binary</option>
                  <option value="prefer-not" <%= user.gender === 'prefer-not' ? 'selected' : '' %>>Prefer not to say</option>
                </select>
              </div>
            </div>
          </div>

          <div style="display:flex; gap:1rem; margin-top:0.5rem;">
            <button type="submit" class="btn-primary">
              <span class="material-symbols-outlined">save</span> Save Changes
            </button>
            <a href="/dashboard" class="btn-secondary" style="text-decoration:none;">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>
</body>
</html>
