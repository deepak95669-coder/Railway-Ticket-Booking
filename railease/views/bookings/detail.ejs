<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
  <style>
    @media print { .no-print { display: none !important; } }
  </style>
</head>
<body style="background:var(--surface);">
<%- include('../partials/sidebar') %>
<div class="main-content">
  <%- include('../partials/header') %>
  <main style="padding:2rem 3rem; background:var(--surface); min-height:calc(100vh - 4rem);">

    <!-- Flash -->
    <% if (success && success.length > 0) { %>
      <div class="flash-success fade-in"><span class="material-symbols-outlined" style="font-size:18px;">check_circle</span><%= success[0] %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="flash-error fade-in"><span class="material-symbols-outlined" style="font-size:18px;">error</span><%= error[0] %></div>
    <% } %>

    <!-- Back + Actions -->
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem;" class="no-print">
      <a href="/bookings" class="btn-secondary" style="text-decoration:none;">
        <span class="material-symbols-outlined">arrow_back</span> My Bookings
      </a>
      <div style="display:flex; gap:0.75rem;">
        <button onclick="window.print()" class="btn-secondary">
          <span class="material-symbols-outlined">print</span> Print Ticket
        </button>
        <% if (booking.bookingStatus !== 'Cancelled') { %>
        <form action="/bookings/<%= booking._id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this booking?')">
          <button type="submit" class="btn-danger">
            <span class="material-symbols-outlined">cancel</span> Cancel Booking
          </button>
        </form>
        <% } %>
      </div>
    </div>

    <!-- Ticket Card -->
    <div style="max-width:860px; margin:0 auto;">
      <div class="card fade-in" style="padding:0; overflow:hidden;">
        <!-- Ticket Header -->
        <div style="background:var(--primary); padding:2rem 2.5rem; color:var(--on-primary); display:flex; align-items:center; justify-content:space-between;">
          <div>
            <div style="font-family:'Public Sans',sans-serif; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.1em; opacity:0.8; margin-bottom:0.35rem;">RailEase E-Ticket</div>
            <div class="font-headline" style="font-size:1.75rem; font-weight:700;">PNR: <%= booking.pnrNumber %></div>
          </div>
          <div style="text-align:right;">
            <span class="badge" style="background:rgba(255,255,255,0.2); color:#fff; font-size:0.75rem; padding:0.4rem 1rem;"><%= booking.bookingStatus %></span>
            <div style="font-size:0.75rem; opacity:0.75; margin-top:0.5rem;">Booked: <%= new Date(booking.bookedAt).toDateString() %></div>
          </div>
        </div>

        <!-- Train Info -->
        <% if (booking.train) { %>
        <div style="padding:2rem 2.5rem; background:var(--surface-container-low); border-bottom:1px solid rgba(195,198,213,0.2);">
          <div style="display:grid; grid-template-columns:1fr auto 1fr; gap:2rem; align-items:center;">
            <div>
              <span style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--on-surface-variant); display:block; margin-bottom:0.25rem;">Departure</span>
              <span class="font-headline" style="font-size:2.2rem; font-weight:700; color:var(--on-surface);"><%= booking.train.departureTime %></span>
              <span style="font-size:0.875rem; color:var(--on-surface-variant); display:block;"><%= booking.train.fromStation %></span>
              <span style="font-family:'Public Sans',sans-serif; font-size:0.78rem; font-weight:700; color:var(--primary);"><%= booking.train.fromCode %></span>
            </div>
            <div style="text-align:center; min-width:140px;">
              <div class="font-headline" style="font-size:1rem; font-weight:700; color:var(--on-surface); margin-bottom:0.25rem;"><%= booking.train.trainName %></div>
              <div style="font-size:0.75rem; color:var(--on-surface-variant); margin-bottom:0.5rem;">#<%= booking.train.trainNumber %></div>
              <div style="display:flex; align-items:center; gap:0.5rem;">
                <div style="flex:1; height:2px; background:rgba(195,198,213,0.5);"></div>
                <span class="material-symbols-outlined" style="color:var(--primary); font-size:20px;">train</span>
                <div style="flex:1; height:2px; background:rgba(195,198,213,0.5);"></div>
              </div>
              <div style="font-size:0.72rem; color:var(--on-surface-variant); margin-top:0.4rem;"><%= booking.train.duration %></div>
            </div>
            <div style="text-align:right;">
              <span style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--on-surface-variant); display:block; margin-bottom:0.25rem;">Arrival</span>
              <span class="font-headline" style="font-size:2.2rem; font-weight:700; color:var(--on-surface);"><%= booking.train.arrivalTime %></span>
              <span style="font-size:0.875rem; color:var(--on-surface-variant); display:block;"><%= booking.train.toStation %></span>
              <span style="font-family:'Public Sans',sans-serif; font-size:0.78rem; font-weight:700; color:var(--primary);"><%= booking.train.toCode %></span>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Booking Meta -->
        <div style="padding:1.5rem 2.5rem; display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; border-bottom:1px solid rgba(195,198,213,0.2); background:var(--surface-container-lowest);">
          <div>
            <div style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--on-surface-variant); margin-bottom:0.3rem;">Journey Date</div>
            <div style="font-weight:700; font-size:0.9rem; color:var(--on-surface);"><%= new Date(booking.journeyDate).toDateString() %></div>
          </div>
          <div>
            <div style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--on-surface-variant); margin-bottom:0.3rem;">Travel Class</div>
            <div style="font-weight:700; font-size:0.9rem; color:var(--on-surface);"><%= booking.travelClass %></div>
          </div>
          <div>
            <div style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--on-surface-variant); margin-bottom:0.3rem;">Total Fare</div>
            <div class="font-headline" style="font-weight:700; font-size:1.1rem; color:var(--primary);">₹<%= booking.totalFare %></div>
          </div>
          <div>
            <div style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--on-surface-variant); margin-bottom:0.3rem;">Payment</div>
            <span class="badge badge-<%= booking.paymentStatus.toLowerCase() %>"><%= booking.paymentStatus %></span>
          </div>
        </div>

        <!-- Passenger Table -->
        <div style="padding:1.5rem 2.5rem;">
          <h3 class="font-headline" style="font-size:1rem; font-weight:700; color:var(--on-surface); margin-bottom:1rem;">Passenger Details</h3>
          <table style="width:100%; border-collapse:collapse; font-size:0.875rem;">
            <thead>
              <tr style="background:var(--surface-container-low);">
                <th style="text-align:left; padding:0.75rem 1rem; font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--on-surface-variant); font-weight:700;">#</th>
                <th style="text-align:left; padding:0.75rem 1rem; font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--on-surface-variant); font-weight:700;">Name</th>
                <th style="text-align:left; padding:0.75rem 1rem; font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--on-surface-variant); font-weight:700;">Age</th>
                <th style="text-align:left; padding:0.75rem 1rem; font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--on-surface-variant); font-weight:700;">Gender</th>
                <th style="text-align:left; padding:0.75rem 1rem; font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--on-surface-variant); font-weight:700;">Seat</th>
              </tr>
            </thead>
            <tbody>
              <% booking.passengers.forEach((p, i) => { %>
              <tr style="border-top:1px solid rgba(195,198,213,0.15);">
                <td style="padding:0.875rem 1rem; color:var(--on-surface-variant);"><%= i+1 %></td>
                <td style="padding:0.875rem 1rem; font-weight:700; color:var(--on-surface);"><%= p.name %></td>
                <td style="padding:0.875rem 1rem; color:var(--on-surface);"><%= p.age %></td>
                <td style="padding:0.875rem 1rem; color:var(--on-surface); text-transform:capitalize;"><%= p.gender %></td>
                <td style="padding:0.875rem 1rem; font-family:'Courier New',monospace; color:var(--primary); font-weight:700;"><%= p.seatNumber || 'TBD' %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Cancellation Note -->
        <% if (booking.bookingStatus === 'Cancelled') { %>
        <div style="margin:0 2.5rem 1.5rem; background:var(--error-container); border-radius:10px; padding:1rem 1.25rem; display:flex; align-items:center; gap:0.75rem;">
          <span class="material-symbols-outlined" style="color:var(--on-error-container); font-size:20px;">info</span>
          <span style="font-size:0.875rem; color:var(--on-error-container);">This booking has been cancelled. Refund status: <strong><%= booking.paymentStatus %></strong></span>
        </div>
        <% } %>
      </div>
    </div>
  </main>
</div>
</body>
</html>
