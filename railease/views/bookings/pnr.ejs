<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
</head>
<body style="background:var(--surface);">
<%- include('../partials/sidebar') %>
<div class="main-content">
  <%- include('../partials/header') %>
  <main style="padding:2rem 3rem; background:var(--surface); min-height:calc(100vh - 4rem);">
    <h1 class="font-headline" style="font-size:1.8rem; font-weight:700; color:var(--on-surface); margin-bottom:0.35rem;">PNR Status</h1>
    <p style="color:var(--on-surface-variant); font-size:0.875rem; margin-bottom:2rem;">Enter your 10-digit PNR number to check booking status.</p>

    <!-- Flash -->
    <% if (error && error.length > 0) { %>
      <div class="flash-error"><span class="material-symbols-outlined" style="font-size:18px;">error</span><%= error[0] %></div>
    <% } %>

    <!-- Search Form -->
    <div class="card fade-in" style="max-width:600px; margin-bottom:2rem;">
      <form action="/bookings/pnr/check" method="GET" style="display:flex; gap:1rem; align-items:flex-end;">
        <div style="flex:1;">
          <label class="form-label">PNR Number</label>
          <div class="input-icon-wrap">
            <span class="input-icon material-symbols-outlined">confirmation_number</span>
            <input type="text" name="pnr" class="form-input" placeholder="e.g. 4829103921" value="<%= pnr %>" maxlength="10" minlength="10" pattern="[0-9]{10}" required/>
          </div>
        </div>
        <button type="submit" class="btn-primary" style="white-space:nowrap;">
          <span class="material-symbols-outlined">search</span> Check Status
        </button>
      </form>
    </div>

    <!-- PNR Result -->
    <% if (pnr && !booking) { %>
      <div class="card fade-in" style="max-width:600px; text-align:center; padding:3rem;">
        <span class="material-symbols-outlined" style="font-size:3rem; color:var(--outline); display:block; margin-bottom:1rem;">search_off</span>
        <h3 class="font-headline" style="font-size:1.2rem; color:var(--on-surface); margin-bottom:0.5rem;">PNR Not Found</h3>
        <p style="color:var(--on-surface-variant); font-size:0.875rem;">No booking found for PNR <strong><%= pnr %></strong>. Please check the number and try again.</p>
      </div>
    <% } %>

    <% if (booking) { %>
    <div class="card fade-in" style="max-width:800px;">
      <!-- Status Banner -->
      <%
        const pnrStatusClass = (booking.bookingStatus || 'pending').toLowerCase();
        const pnrIcon = booking.bookingStatus === 'Confirmed' ? 'check_circle' : (booking.bookingStatus === 'Cancelled' ? 'cancel' : 'pending');
      %>
      <div class="status-box <%= pnrStatusClass %>" style="border-radius:10px; padding:1.25rem 1.5rem; display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem;">
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <span class="material-symbols-outlined" style="font-size:22px; font-variation-settings:'FILL' 1;">
            <%= pnrIcon %>
          </span>
          <div>
            <div class="font-headline" style="font-size:1.1rem; font-weight:700; color:var(--on-surface);">PNR: <%= booking.pnrNumber %></div>
            <div style="font-size:0.78rem; color:var(--on-surface-variant);">Booked on <%= new Date(booking.bookedAt).toDateString() %></div>
          </div>
        </div>
        <span class="badge badge-<%= pnrStatusClass %>" style="font-size:0.78rem; padding:0.4rem 1rem;"><%= booking.bookingStatus %></span>
      </div>

      <!-- Train Info -->
      <% if (booking.train) { %>
      <div style="background:var(--surface-container-low); border-radius:10px; padding:1.5rem; margin-bottom:1.25rem;">
        <div style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--primary); font-weight:700; margin-bottom:0.5rem;"><%= booking.train.trainType %></div>
        <div class="font-headline" style="font-size:1.15rem; font-weight:700; color:var(--on-surface); margin-bottom:1rem;"><%= booking.train.trainName %> (#<%= booking.train.trainNumber %>)</div>
        <div style="display:grid; grid-template-columns:1fr auto 1fr; gap:1.5rem; align-items:center;">
          <div>
            <div class="font-headline" style="font-size:1.8rem; font-weight:700; color:var(--on-surface);"><%= booking.train.departureTime %></div>
            <div style="font-size:0.8rem; color:var(--on-surface-variant);"><%= booking.train.fromStation %> (<%= booking.train.fromCode %>)</div>
          </div>
          <div style="text-align:center;">
            <div style="font-size:0.75rem; color:var(--on-surface-variant); margin-bottom:0.35rem;"><%= booking.train.duration %></div>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <div style="flex:1; height:2px; background:rgba(195,198,213,0.5);"></div>
              <span class="material-symbols-outlined" style="color:var(--primary); font-size:18px;">train</span>
              <div style="flex:1; height:2px; background:rgba(195,198,213,0.5);"></div>
            </div>
          </div>
          <div style="text-align:right;">
            <div class="font-headline" style="font-size:1.8rem; font-weight:700; color:var(--on-surface);"><%= booking.train.arrivalTime %></div>
            <div style="font-size:0.8rem; color:var(--on-surface-variant);"><%= booking.train.toStation %> (<%= booking.train.toCode %>)</div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Details Grid -->
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:1.25rem;">
        <div style="background:var(--surface-container-low); padding:1rem; border-radius:8px;">
          <div style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; color:var(--on-surface-variant); margin-bottom:0.3rem;">Journey Date</div>
          <div style="font-weight:700; color:var(--on-surface);"><%= new Date(booking.journeyDate).toDateString() %></div>
        </div>
        <div style="background:var(--surface-container-low); padding:1rem; border-radius:8px;">
          <div style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; color:var(--on-surface-variant); margin-bottom:0.3rem;">Class</div>
          <div style="font-weight:700; color:var(--on-surface);"><%= booking.travelClass %></div>
        </div>
        <div style="background:var(--surface-container-low); padding:1rem; border-radius:8px;">
          <div style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; color:var(--on-surface-variant); margin-bottom:0.3rem;">Total Fare</div>
          <div class="font-headline" style="font-weight:700; color:var(--primary);">₹<%= booking.totalFare %></div>
        </div>
      </div>

      <!-- Passenger List -->
      <div>
        <h3 class="font-headline" style="font-size:0.95rem; font-weight:700; color:var(--on-surface); margin-bottom:0.75rem;">Passengers (<%= booking.passengers.length %>)</h3>
        <% booking.passengers.forEach((p, i) => { %>
        <div style="display:flex; align-items:center; justify-content:space-between; padding:0.75rem 1rem; background:var(--surface-container-low); border-radius:8px; margin-bottom:0.5rem;">
          <div style="display:flex; align-items:center; gap:0.75rem;">
            <div style="width:32px; height:32px; border-radius:50%; background:var(--primary-fixed); display:flex; align-items:center; justify-content:center; font-weight:700; color:var(--primary); font-size:0.75rem;"><%= i+1 %></div>
            <div>
              <div style="font-weight:700; color:var(--on-surface); font-size:0.875rem;"><%= p.name %></div>
              <div style="font-size:0.72rem; color:var(--on-surface-variant); text-transform:capitalize;">Age: <%= p.age %> · <%= p.gender %></div>
            </div>
          </div>
          <div style="font-family:'Courier New',monospace; color:var(--primary); font-weight:700; font-size:0.875rem;"><%= p.seatNumber || 'TBD' %></div>
        </div>
        <% }) %>
      </div>

      <div style="margin-top:1.5rem; text-align:center;" class="no-print">
        <a href="/bookings/<%= booking._id %>" class="btn-primary" style="text-decoration:none;">
          View Full Ticket <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
        </a>
      </div>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
