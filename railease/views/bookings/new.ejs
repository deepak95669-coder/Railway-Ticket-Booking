<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
</head>
<body style="background:var(--surface);">
<%- include('../partials/sidebar') %>
<div class="main-content">
  <%- include('../partials/header') %>
  <main style="padding:2rem 3rem; background:var(--surface); min-height:calc(100vh - 4rem);">

    <!-- Page Header -->
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:2rem;">
      <div>
        <h1 class="font-headline" style="font-size:1.8rem; font-weight:700; color:var(--on-surface);">Book Ticket</h1>
        <p style="color:var(--on-surface-variant); font-size:0.875rem; margin-top:0.25rem;">Complete your journey reservation below.</p>
      </div>
      <a href="/trains/<%= train._id %>?date=<%= journeyDate %>" class="btn-secondary" style="text-decoration:none;">
        <span class="material-symbols-outlined">arrow_back</span> Back
      </a>
    </div>

    <!-- Flash Messages -->
    <% if (error && error.length > 0) { %>
      <div class="flash-error"><span class="material-symbols-outlined" style="font-size:18px;">error</span><%= error[0] %></div>
    <% } %>

    <div style="display:grid; grid-template-columns:2fr 1fr; gap:2rem;">
      <!-- Left: Booking Form -->
      <div>
        <form action="/bookings" method="POST" id="bookingForm">
          <input type="hidden" name="trainId" value="<%= train._id %>"/>

          <!-- Journey Details -->
          <div class="card fade-in" style="margin-bottom:1.5rem;">
            <h2 class="font-headline" style="font-size:1.1rem; font-weight:700; color:var(--on-surface); margin-bottom:1.25rem;">Journey Details</h2>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
              <div>
                <label class="form-label">Journey Date</label>
                <div class="input-icon-wrap">
                  <span class="input-icon material-symbols-outlined">calendar_today</span>
                  <input type="date" name="journeyDate" class="form-input" value="<%= journeyDate %>" required/>
                </div>
              </div>
              <div>
                <label class="form-label">Travel Class</label>
                <div class="input-icon-wrap">
                  <span class="input-icon material-symbols-outlined">airline_seat_recline_normal</span>
                  <select name="travelClass" class="form-input" style="appearance:none; cursor:pointer;" required>
                    <% train.classes.forEach(cls => { %>
                    <option value="<%= cls.className %>" <%= selectedClass === cls.className ? 'selected' : '' %>>
                      <%= cls.className %> — ₹<%= cls.price %> (<%= cls.availableSeats %> seats)
                    </option>
                    <% }) %>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Passenger Details -->
          <div class="card fade-in" id="passengerSection" style="margin-bottom:1.5rem;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.25rem;">
              <h2 class="font-headline" style="font-size:1.1rem; font-weight:700; color:var(--on-surface);">Passenger Details</h2>
              <button type="button" onclick="addPassenger()" class="btn-secondary" style="font-size:0.72rem; padding:0.5rem 1rem;">
                <span class="material-symbols-outlined" style="font-size:16px;">person_add</span> Add Passenger
              </button>
            </div>

            <div id="passengerList" style="display:flex; flex-direction:column; gap:1rem;">
              <!-- Passenger 1 (default) -->
              <div class="passenger-row" style="background:var(--surface-container-low); border-radius:10px; padding:1.25rem; position:relative;">
                <div style="font-family:'Public Sans',sans-serif; font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--primary); margin-bottom:0.75rem;">Passenger 1</div>
                <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:0.75rem;">
                  <div>
                    <label class="form-label">Full Name</label>
                    <div class="input-icon-wrap">
                      <span class="input-icon material-symbols-outlined">person</span>
                      <input type="text" name="passengerNames" class="form-input" placeholder="Full Name" required/>
                    </div>
                  </div>
                  <div>
                    <label class="form-label">Age</label>
                    <div class="input-icon-wrap">
                      <span class="input-icon material-symbols-outlined">cake</span>
                      <input type="number" name="passengerAges" class="form-input" placeholder="Age" min="1" max="120" required/>
                    </div>
                  </div>
                  <div>
                    <label class="form-label">Gender</label>
                    <div class="input-icon-wrap">
                      <span class="input-icon material-symbols-outlined">wc</span>
                      <select name="passengerGenders" class="form-input" style="appearance:none; cursor:pointer;" required>
                        <option value="">Select</option>
                        <option value="male">Male</option>
                        <option value="female">Female</option>
                        <option value="other">Other</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn-primary" style="width:100%; justify-content:center; padding:1.1rem; font-size:0.9rem;">
            <span class="material-symbols-outlined">confirmation_number</span>
            Confirm & Book Ticket
          </button>
          <p style="text-align:center; font-size:0.75rem; color:var(--on-surface-variant); margin-top:0.75rem;">
            By booking, you agree to RailEase Terms of Service and Cancellation Policy.
          </p>
        </form>
      </div>

      <!-- Right: Train Summary -->
      <div style="display:flex; flex-direction:column; gap:1.5rem;">
        <div class="card fade-in">
          <h3 class="font-headline" style="font-size:1.1rem; font-weight:700; color:var(--on-surface); margin-bottom:1.25rem;">Train Summary</h3>
          <div style="background:var(--surface-container-low); border-radius:10px; padding:1.25rem; margin-bottom:1rem;">
            <div class="font-headline" style="font-size:1rem; font-weight:700; color:var(--on-surface); margin-bottom:0.35rem;"><%= train.trainName %></div>
            <div style="font-size:0.75rem; color:var(--on-surface-variant);">#<%= train.trainNumber %> &nbsp;·&nbsp; <%= train.trainType %></div>
          </div>
          <div style="display:flex; flex-direction:column; gap:0.75rem; font-size:0.875rem;">
            <div style="display:flex; justify-content:space-between;">
              <span style="color:var(--on-surface-variant);">Departure</span>
              <span style="font-weight:700;"><%= train.departureTime %> &nbsp;(<%= train.fromCode %>)</span>
            </div>
            <div style="display:flex; justify-content:space-between; padding-top:0.5rem; border-top:1px solid rgba(195,198,213,0.2);">
              <span style="color:var(--on-surface-variant);">Arrival</span>
              <span style="font-weight:700;"><%= train.arrivalTime %> &nbsp;(<%= train.toCode %>)</span>
            </div>
            <div style="display:flex; justify-content:space-between; padding-top:0.5rem; border-top:1px solid rgba(195,198,213,0.2);">
              <span style="color:var(--on-surface-variant);">Duration</span>
              <span style="font-weight:700;"><%= train.duration %></span>
            </div>
          </div>
        </div>

        <!-- Fare Info -->
        <div class="card fade-in">
          <h3 class="font-headline" style="font-size:1rem; font-weight:700; color:var(--on-surface); margin-bottom:1rem;">Fare Breakdown</h3>
          <% train.classes.forEach(cls => { %>
          <div id="fare-<%= cls.className %>" style="display:none; flex-direction:column; gap:0.5rem; font-size:0.875rem;">
            <div style="display:flex; justify-content:space-between;">
              <span style="color:var(--on-surface-variant);">Base Fare (<%= cls.className %>)</span>
              <span style="font-weight:700;">₹<%= cls.price %></span>
            </div>
            <div style="display:flex; justify-content:space-between;">
              <span style="color:var(--on-surface-variant);">Reservation Fee</span>
              <span style="font-weight:700;">₹30</span>
            </div>
            <div style="display:flex; justify-content:space-between; padding-top:0.75rem; border-top:1px solid rgba(195,198,213,0.2);">
              <span style="font-weight:700; color:var(--on-surface);">Total (per person)</span>
              <span class="font-headline" style="font-size:1.1rem; font-weight:700; color:var(--primary);">₹<%= cls.price + 30 %></span>
            </div>
          </div>
          <% }) %>
        </div>

        <div style="background:var(--tertiary-fixed); border-radius:10px; padding:1.25rem;" class="fade-in">
          <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
            <span class="material-symbols-outlined" style="color:var(--on-tertiary-container); font-size:18px;">info</span>
            <span style="font-family:'Public Sans',sans-serif; font-size:0.7rem; font-weight:700; text-transform:uppercase; color:var(--on-tertiary-container);">Booking Policy</span>
          </div>
          <p style="font-size:0.78rem; color:var(--on-tertiary-container); line-height:1.6;">
            Full refund available up to 4 hrs before departure. 50% refund up to 2 hrs before departure.
          </p>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
  let passengerCount = 1;
  function addPassenger() {
    if (passengerCount >= 6) { alert('Maximum 6 passengers per booking.'); return; }
    passengerCount++;
    const list = document.getElementById('passengerList');
    const div = document.createElement('div');
    div.className = 'passenger-row';
    div.style.cssText = 'background:var(--surface-container-low); border-radius:10px; padding:1.25rem; position:relative;';
    div.innerHTML = `
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
        <div style="font-family:'Public Sans',sans-serif; font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--primary);">Passenger ${passengerCount}</div>
        <button type="button" onclick="this.closest('.passenger-row').remove(); passengerCount--;" style="background:none; border:none; cursor:pointer; color:var(--error);" title="Remove">
          <span class="material-symbols-outlined" style="font-size:18px;">close</span>
        </button>
      </div>
      <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:0.75rem;">
        <div><label class="form-label">Full Name</label><div class="input-icon-wrap"><span class="input-icon material-symbols-outlined">person</span><input type="text" name="passengerNames" class="form-input" placeholder="Full Name" required/></div></div>
        <div><label class="form-label">Age</label><div class="input-icon-wrap"><span class="input-icon material-symbols-outlined">cake</span><input type="number" name="passengerAges" class="form-input" placeholder="Age" min="1" max="120" required/></div></div>
        <div><label class="form-label">Gender</label><div class="input-icon-wrap"><span class="input-icon material-symbols-outlined">wc</span><select name="passengerGenders" class="form-input" style="appearance:none; cursor:pointer;" required><option value="">Select</option><option value="male">Male</option><option value="female">Female</option><option value="other">Other</option></select></div></div>
      </div>`;
    list.appendChild(div);
  }

  // Show fare based on selected class
  const classSelect = document.querySelector('select[name="travelClass"]');
  function updateFare() {
    document.querySelectorAll('[id^="fare-"]').forEach(el => el.style.display = 'none');
    const selected = classSelect.value;
    const fareEl = document.getElementById('fare-' + selected);
    if (fareEl) fareEl.style.display = 'flex';
  }
  classSelect.addEventListener('change', updateFare);
  updateFare();
</script>
</body>
</html>
