<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
</head>
<body style="background:var(--surface);">
<%- include('../partials/sidebar') %>
<div class="main-content">
  <%- include('../partials/header') %>
  <main style="padding:2rem 3rem; background:var(--surface); min-height:calc(100vh - 4rem);">

    <!-- Flash -->
    <% if (success && success.length > 0) { %>
      <div class="flash-success fade-in"><span class="material-symbols-outlined" style="font-size:18px;">check_circle</span><%= success[0] %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="flash-error fade-in"><span class="material-symbols-outlined" style="font-size:18px;">error</span><%= error[0] %></div>
    <% } %>

    <!-- Header -->
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:2rem;">
      <div>
        <h1 class="font-headline" style="font-size:1.8rem; font-weight:700; color:var(--on-surface);">My Bookings</h1>
        <p style="color:var(--on-surface-variant); font-size:0.875rem; margin-top:0.25rem;">All your railway reservations in one place.</p>
      </div>
      <a href="/trains/search" class="btn-primary" style="text-decoration:none;">
        <span class="material-symbols-outlined">add</span> New Booking
      </a>
    </div>

    <!-- Booking List -->
    <% if (bookings.length === 0) { %>
      <div style="text-align:center; padding:5rem 2rem; background:var(--surface-container-lowest); border-radius:14px;">
        <span class="material-symbols-outlined" style="font-size:4rem; color:var(--outline); display:block; margin-bottom:1rem;">book_online</span>
        <h3 class="font-headline" style="font-size:1.4rem; color:var(--on-surface-variant); margin-bottom:0.5rem;">No Bookings Yet</h3>
        <p style="color:var(--on-surface-variant); font-size:0.9rem; margin-bottom:1.5rem;">Start your journey by booking a train ticket.</p>
        <a href="/trains/search" class="btn-primary" style="text-decoration:none;">Search Trains</a>
      </div>
    <% } else { %>
      <div style="display:flex; flex-direction:column; gap:1.25rem;">
        <% bookings.forEach((booking, idx) => { 
            const statusClass = (booking.bookingStatus || 'pending').toLowerCase();
            const statusIcon = booking.bookingStatus === 'Confirmed' ? 'confirmation_number' : (booking.bookingStatus === 'Cancelled' ? 'cancel' : 'pending');
        %>
        <div class="train-card fade-in" style="animation-delay:<%= idx * 0.05 %>s;">
          <div style="display:grid; grid-template-columns:auto 1fr auto auto; gap:1.5rem; align-items:center;">
            <!-- Status Icon -->
            <div class="status-box <%= statusClass %>" style="width:48px; height:48px;">
              <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1; font-size:22px;">
                <%= statusIcon %>
              </span>
            </div>

            <!-- Train & Route Info -->
            <div>
              <% if (booking.train) { %>
                <div class="font-headline" style="font-size:1.05rem; font-weight:700; color:var(--on-surface); margin-bottom:0.2rem;"><%= booking.train.trainName %> <span style="font-weight:400; color:var(--on-surface-variant); font-size:0.85rem;">(#<%= booking.train.trainNumber %>)</span></div>
                <div style="font-size:0.82rem; color:var(--on-surface-variant); display:flex; align-items:center; gap:0.5rem;">
                  <span><%= booking.train.fromCode %></span>
                  <span class="material-symbols-outlined" style="font-size:14px;">arrow_forward</span>
                  <span><%= booking.train.toCode %></span>
                  <span style="color:var(--outline-variant);">·</span>
                  <span><%= booking.travelClass %></span>
                  <span style="color:var(--outline-variant);">·</span>
                  <span><%= new Date(booking.journeyDate).toDateString() %></span>
                </div>
              <% } else { %>
                <div class="font-headline" style="font-size:1rem; color:var(--on-surface-variant);">Train info unavailable</div>
              <% } %>
              <div style="margin-top:0.5rem;">
                <span class="badge badge-<%= booking.bookingStatus.toLowerCase() %>"><%= booking.bookingStatus %></span>
                <span style="margin-left:0.5rem; font-family:'Public Sans',sans-serif; font-size:0.68rem; color:var(--on-surface-variant);">PNR: <%= booking.pnrNumber %></span>
              </div>
            </div>

            <!-- Fare -->
            <div style="text-align:right;">
              <div class="font-headline" style="font-size:1.2rem; font-weight:700; color:var(--primary);">₹<%= booking.totalFare %></div>
              <div style="font-size:0.72rem; color:var(--on-surface-variant);"><%= booking.passengers.length %> passenger(s)</div>
            </div>

            <!-- Actions -->
            <div style="display:flex; flex-direction:column; gap:0.5rem; align-items:flex-end;">
              <a href="/bookings/<%= booking._id %>" class="btn-secondary" style="text-decoration:none; font-size:0.72rem; padding:0.5rem 0.9rem;">
                View Details
              </a>
              <% if (booking.bookingStatus !== 'Cancelled') { %>
              <form action="/bookings/<%= booking._id %>/cancel" method="POST" onsubmit="return confirm('Cancel this booking? Refund will be processed.')">
                <button type="submit" class="btn-danger" style="font-size:0.68rem; padding:0.4rem 0.8rem; width:100%;">Cancel</button>
              </form>
              <% } %>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>
</body>
</html>
