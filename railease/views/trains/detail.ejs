<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
</head>
<body style="background:var(--surface);">
<%- include('../partials/sidebar') %>
<div class="main-content">
  <%- include('../partials/header') %>
  <main style="padding:2rem 3rem; background:var(--surface); min-height:calc(100vh - 4rem);">
    <a href="/trains/search?from=<%= train.fromCode %>&to=<%= train.toCode %>&date=<%= query.date || '' %>" class="btn-secondary" style="text-decoration:none; margin-bottom:1.5rem; display:inline-flex;">
      <span class="material-symbols-outlined">arrow_back</span> Back to Results
    </a>

    <div style="display:grid; grid-template-columns:2fr 1fr; gap:2rem; margin-top:1rem;">
      <!-- Left: Train Info -->
      <div style="display:flex; flex-direction:column; gap:1.5rem;">
        <!-- Train Header Card -->
        <div class="card fade-in">
          <div style="display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:1.5rem;">
            <div>
              <span style="background:rgba(9,76,178,0.1); color:var(--primary); font-family:'Public Sans',sans-serif; font-size:0.65rem; font-weight:700; padding:0.25rem 0.65rem; border-radius:6px; display:inline-block; margin-bottom:0.5rem;"><%= train.trainType %></span>
              <h1 class="font-headline" style="font-size:1.8rem; font-weight:700; color:var(--on-surface); margin-bottom:0.25rem;"><%= train.trainName %></h1>
              <p style="font-family:'Public Sans',sans-serif; font-size:0.8rem; color:var(--on-surface-variant);">Train #<%= train.trainNumber %> &nbsp;|&nbsp; Runs: <%= train.runningDays.join(', ') %></p>
            </div>
            <span style="background:rgba(109,94,0,0.1); color:var(--tertiary); font-family:'Public Sans',sans-serif; font-size:0.7rem; font-weight:700; padding:0.4rem 0.9rem; border-radius:999px;">🔥 High Demand</span>
          </div>

          <!-- Timings Visual -->
          <div style="background:var(--surface-container-low); border-radius:12px; padding:1.5rem 2rem; display:grid; grid-template-columns:1fr auto 1fr; gap:2rem; align-items:center;">
            <div>
              <span style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--on-surface-variant); display:block; margin-bottom:0.25rem;">Departure</span>
              <span class="font-headline" style="font-size:2.5rem; font-weight:700; color:var(--on-surface);"><%= train.departureTime %></span>
              <span style="font-size:0.875rem; color:var(--on-surface-variant); display:block; margin-top:0.25rem;"><%= train.fromStation %></span>
              <span style="font-family:'Public Sans',sans-serif; font-size:0.75rem; font-weight:700; color:var(--primary);"><%= train.fromCode %></span>
            </div>
            <div style="text-align:center; min-width:120px;">
              <span style="font-size:0.8rem; color:var(--on-surface-variant); display:block; margin-bottom:0.5rem;"><%= train.duration %></span>
              <div style="display:flex; align-items:center; gap:0.5rem;">
                <div style="flex:1; height:2px; background:var(--outline-variant);"></div>
                <span class="material-symbols-outlined" style="color:var(--primary); font-size:22px;">train</span>
                <div style="flex:1; height:2px; background:var(--outline-variant);"></div>
              </div>
              <span style="font-size:0.65rem; color:var(--tertiary); font-weight:700; text-transform:uppercase; display:block; margin-top:0.5rem;">Direct Service</span>
            </div>
            <div style="text-align:right;">
              <span style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--on-surface-variant); display:block; margin-bottom:0.25rem;">Arrival</span>
              <span class="font-headline" style="font-size:2.5rem; font-weight:700; color:var(--on-surface);"><%= train.arrivalTime %></span>
              <span style="font-size:0.875rem; color:var(--on-surface-variant); display:block; margin-top:0.25rem;"><%= train.toStation %></span>
              <span style="font-family:'Public Sans',sans-serif; font-size:0.75rem; font-weight:700; color:var(--primary);"><%= train.toCode %></span>
            </div>
          </div>
        </div>

        <!-- Class Availability -->
        <div class="card fade-in">
          <h2 class="font-headline" style="font-size:1.2rem; font-weight:700; color:var(--on-surface); margin-bottom:1.25rem;">Select Class & Book</h2>
          <div style="display:flex; flex-direction:column; gap:0.75rem;">
            <% train.classes.forEach(cls => { 
                let seatStatus = 'waitlist';
                if (cls.availableSeats > 10) seatStatus = 'available';
                else if (cls.availableSeats > 0) seatStatus = 'low';
            %>
            <div style="background:var(--surface-container-low); border-radius:10px; padding:1.25rem 1.5rem; display:grid; grid-template-columns:auto 1fr auto auto; gap:1.5rem; align-items:center; transition:background 0.2s;" onmouseover="this.style.background='var(--surface-container-high)'" onmouseout="this.style.background='var(--surface-container-low)'">
              <div style="width:48px; height:48px; border-radius:10px; background:var(--primary-fixed); display:flex; align-items:center; justify-content:center; font-family:'Noto Serif',serif; font-weight:700; color:var(--primary); font-size:0.85rem;"><%= cls.className %></div>
              <div>
                <div style="font-weight:700; font-size:0.95rem; color:var(--on-surface); margin-bottom:0.2rem;"><%= cls.className %></div>
                <div style="display:flex; align-items:center; gap:0.5rem;">
                  <span class="seat-dot <%= seatStatus %>"></span>
                  <span class="seat-status-text <%= seatStatus %>" style="font-size:0.75rem; font-weight:600;">
                    <%= cls.availableSeats > 0 ? 'Available — ' + cls.availableSeats + ' seats' : 'Waitlisted' %>
                  </span>
                </div>
              </div>
              <div style="text-align:right;">
                <span class="font-headline" style="font-size:1.3rem; font-weight:700; color:var(--primary);">₹<%= cls.price %></span>
                <span style="font-size:0.72rem; color:var(--on-surface-variant); display:block;">per person</span>
              </div>
              <a href="/bookings/new/<%= train._id %>?class=<%= cls.className %>&date=<%= query.date || '' %>" class="btn-primary" style="text-decoration:none; font-size:0.75rem; padding:0.65rem 1rem; white-space:nowrap;">
                Book <span class="material-symbols-outlined" style="font-size:15px;">arrow_forward</span>
              </a>
            </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Right: Summary -->
      <div style="display:flex; flex-direction:column; gap:1.5rem;">
        <div class="card fade-in">
          <h3 class="font-headline" style="font-size:1.1rem; font-weight:700; color:var(--on-surface); margin-bottom:1rem;">Journey Summary</h3>
          <div style="display:flex; flex-direction:column; gap:0.75rem; font-size:0.875rem;">
            <div style="display:flex; justify-content:space-between; padding-bottom:0.75rem; border-bottom:1px solid rgba(195,198,213,0.2);">
              <span style="color:var(--on-surface-variant);">Train</span>
              <span style="font-weight:700; color:var(--on-surface);"><%= train.trainNumber %></span>
            </div>
            <div style="display:flex; justify-content:space-between; padding-bottom:0.75rem; border-bottom:1px solid rgba(195,198,213,0.2);">
              <span style="color:var(--on-surface-variant);">From</span>
              <span style="font-weight:700; color:var(--on-surface);"><%= train.fromCode %></span>
            </div>
            <div style="display:flex; justify-content:space-between; padding-bottom:0.75rem; border-bottom:1px solid rgba(195,198,213,0.2);">
              <span style="color:var(--on-surface-variant);">To</span>
              <span style="font-weight:700; color:var(--on-surface);"><%= train.toCode %></span>
            </div>
            <div style="display:flex; justify-content:space-between; padding-bottom:0.75rem; border-bottom:1px solid rgba(195,198,213,0.2);">
              <span style="color:var(--on-surface-variant);">Duration</span>
              <span style="font-weight:700; color:var(--on-surface);"><%= train.duration %></span>
            </div>
            <div style="display:flex; justify-content:space-between;">
              <span style="color:var(--on-surface-variant);">Journey Date</span>
              <span style="font-weight:700; color:var(--on-surface);"><%= query.date ? new Date(query.date).toDateString() : 'Not selected' %></span>
            </div>
          </div>
        </div>

        <div style="background:var(--primary); border-radius:12px; padding:1.5rem; color:var(--on-primary);" class="fade-in">
          <span class="material-symbols-outlined" style="font-size:2rem; display:block; margin-bottom:0.75rem;">shield</span>
          <h4 class="font-headline" style="font-size:1rem; font-weight:700; margin-bottom:0.5rem;">RailEase Secure Booking</h4>
          <p style="font-size:0.8rem; opacity:0.85; line-height:1.6;">Instant e-ticket, 24/7 cancellation support, and guaranteed refunds for cancelled trains.</p>
        </div>
      </div>
    </div>
  </main>
</div>
</body>
</html>
