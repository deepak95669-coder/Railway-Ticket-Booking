<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
</head>
<body style="background:var(--surface);">
<%- include('../partials/sidebar') %>
<div class="main-content">
  <%- include('../partials/header') %>
  <main style="min-height:calc(100vh - 4rem); background:var(--surface);">

    <!-- Header Banner -->
    <section style="background:var(--surface-container-low); padding:2.5rem 3rem;">
      <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:0.5rem;">
        <div style="display:flex; align-items:center; gap:0.5rem; font-family:'Public Sans',sans-serif; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--on-surface-variant);">
          <span>Express Route</span>
          <span class="material-symbols-outlined" style="font-size:14px;">arrow_forward</span>
          <span>Verified Schedule</span>
        </div>
        <% if (searched && query.from && query.to) { %>
          <h1 class="font-headline" style="font-size:2.2rem; font-weight:700; color:var(--on-surface);">
            <%= query.from.toUpperCase() %> <span style="color:var(--primary); font-weight:400; margin:0 0.5rem;">→</span> <%= query.to.toUpperCase() %>
          </h1>
          <p style="color:var(--on-surface-variant); font-size:0.9rem;">
            Showing <strong style="color:var(--on-surface);"><%= trains.length %></strong> train(s) available
            <% if (query.date) { %> for <strong style="color:var(--on-surface);"><%= new Date(query.date).toDateString() %></strong><% } %>
          </p>
        <% } else { %>
          <h1 class="font-headline" style="font-size:2.2rem; font-weight:700; color:var(--on-surface);">Search Trains</h1>
          <p style="color:var(--on-surface-variant); font-size:0.9rem;">Find trains between any two stations across India.</p>
        <% } %>
      </div>
    </section>

    <div style="padding:2rem 3rem; display:grid; grid-template-columns:280px 1fr; gap:2rem;">
      <!-- Filter Sidebar -->
      <aside>
        <div style="background:var(--surface-container-low); padding:1.5rem; border-radius:14px; box-shadow:0 2px 8px rgba(0,0,0,0.04); position:sticky; top:4.5rem;">
          <!-- Search Form -->
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.25rem;">
            <h2 class="font-headline" style="font-size:1.1rem; font-weight:700; color:var(--on-surface);">Search & Filters</h2>
          </div>
          <form action="/trains/search" method="GET" style="display:flex; flex-direction:column; gap:1rem;">
            <div>
              <label class="form-label">From Station Code</label>
              <div class="input-icon-wrap">
                <span class="input-icon material-symbols-outlined">trip_origin</span>
                <input type="text" name="from" class="form-input" placeholder="e.g. NDLS, MAS" value="<%= query.from || '' %>"/>
              </div>
            </div>
            <div>
              <label class="form-label">To Station Code</label>
              <div class="input-icon-wrap">
                <span class="input-icon material-symbols-outlined">location_on</span>
                <input type="text" name="to" class="form-input" placeholder="e.g. BCT, SBC" value="<%= query.to || '' %>"/>
              </div>
            </div>
            <div>
              <label class="form-label">Journey Date</label>
              <div class="input-icon-wrap">
                <span class="input-icon material-symbols-outlined">calendar_today</span>
                <input type="date" name="date" class="form-input" value="<%= query.date || '' %>" required/>
              </div>
            </div>
            <div>
              <label class="form-label">Travel Class</label>
              <div class="input-icon-wrap">
                <span class="input-icon material-symbols-outlined">airline_seat_recline_normal</span>
                <select name="travelClass" class="form-input" style="appearance:none; cursor:pointer;">
                  <option value="">All Classes</option>
                  <option value="1A" <%= query.travelClass==='1A'?'selected':'' %>>First AC (1A)</option>
                  <option value="2A" <%= query.travelClass==='2A'?'selected':'' %>>Second AC (2A)</option>
                  <option value="3A" <%= query.travelClass==='3A'?'selected':'' %>>Third AC (3A)</option>
                  <option value="SL" <%= query.travelClass==='SL'?'selected':'' %>>Sleeper (SL)</option>
                  <option value="CC" <%= query.travelClass==='CC'?'selected':'' %>>Chair Car (CC)</option>
                  <option value="EC" <%= query.travelClass==='EC'?'selected':'' %>>Exec Chair (EC)</option>
                </select>
              </div>
            </div>
            <button type="submit" class="btn-primary" style="width:100%; justify-content:center;">
              <span class="material-symbols-outlined">search</span> Search
            </button>
          </form>
        </div>
      </aside>

      <!-- Results Section -->
      <section>
        <% if (error && error.length > 0) { %>
          <div class="flash-error"><span class="material-symbols-outlined" style="font-size:18px;">error</span><%= error[0] %></div>
        <% } %>

        <% if (!searched) { %>
          <!-- Empty State -->
          <div style="text-align:center; padding:5rem 2rem;">
            <span class="material-symbols-outlined" style="font-size:4rem; color:var(--outline); display:block; margin-bottom:1rem;">search</span>
            <h3 class="font-headline" style="font-size:1.4rem; color:var(--on-surface-variant); margin-bottom:0.5rem;">Enter Route to Search</h3>
            <p style="color:var(--on-surface-variant); font-size:0.9rem;">Use the filters on the left to find trains between stations.</p>
          </div>

        <% } else if (trains.length === 0) { %>
          <!-- No Results -->
          <div style="text-align:center; padding:4rem 2rem; background:var(--surface-container-lowest); border-radius:14px;">
            <span class="material-symbols-outlined" style="font-size:3.5rem; color:var(--outline); display:block; margin-bottom:1rem;">train_off</span>
            <h3 class="font-headline" style="font-size:1.3rem; color:var(--on-surface); margin-bottom:0.5rem;">No Trains Found</h3>
            <p style="color:var(--on-surface-variant); font-size:0.875rem; margin-bottom:1.5rem;">Try different station codes or travel dates.</p>
            <a href="/trains/search" class="btn-secondary">Clear Search</a>
          </div>

        <% } else { %>
          <!-- Sort Bar -->
          <div style="display:flex; align-items:center; justify-content:space-between; background:var(--surface-container-low); padding:1rem 1.5rem; border-radius:12px; margin-bottom:1.5rem;">
            <span style="font-size:0.875rem; color:var(--on-surface-variant);">
              Showing <strong style="color:var(--on-surface);"><%= trains.length %></strong> train(s)
            </span>
            <div style="display:flex; align-items:center; gap:0.75rem;">
              <span style="font-family:'Public Sans',sans-serif; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--on-surface-variant);">Sort By:</span>
              <select style="background:var(--surface-container-lowest); border:none; font-size:0.875rem; color:var(--on-surface); padding:0.4rem 0.75rem; border-radius:8px; outline:none; cursor:pointer;">
                <option>Departure: Earliest</option>
                <option>Duration: Shortest</option>
                <option>Price: Low to High</option>
              </select>
            </div>
          </div>

          <!-- Train Cards -->
          <% trains.forEach((train, idx) => { %>
          <div class="train-card fade-in" style="margin-bottom:1.25rem; animation-delay:<%= idx * 0.06 %>s;">
            <!-- Train Header -->
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.25rem;">
              <div>
                <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.3rem;">
                  <span style="background:rgba(9,76,178,0.1); color:var(--primary); font-family:'Public Sans',sans-serif; font-size:0.65rem; font-weight:700; padding:0.25rem 0.65rem; border-radius:6px;"><%= train.trainType %></span>
                  <span style="font-family:'Courier New', monospace; font-size:0.75rem; color:var(--on-surface-variant);">#<%= train.trainNumber %></span>
                </div>
                <h3 class="font-headline" style="font-size:1.15rem; font-weight:700; color:var(--on-surface);"><%= train.trainName %></h3>
              </div>
              <span style="background:rgba(109,94,0,0.1); color:var(--tertiary); font-family:'Public Sans',sans-serif; font-size:0.65rem; font-weight:700; padding:0.3rem 0.8rem; border-radius:999px; display:flex; align-items:center; gap:0.3rem;">
                <span class="material-symbols-outlined" style="font-size:13px;">bolt</span> High Punctuality
              </span>
            </div>

            <!-- Timings -->
            <div style="background:var(--surface-container-lowest); border-radius:10px; padding:1.25rem 1.5rem; display:grid; grid-template-columns:1fr auto 1fr; gap:1.5rem; align-items:center; margin-bottom:1.25rem;">
              <div>
                <span style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--on-surface-variant); display:block; margin-bottom:0.2rem;">Departure</span>
                <span class="font-headline" style="font-size:1.75rem; font-weight:700; color:var(--on-surface);"><%= train.departureTime %></span>
                <span style="font-size:0.75rem; color:var(--on-surface-variant); display:block;"><%= train.fromStation %> (<%= train.fromCode %>)</span>
              </div>
              <div style="text-align:center;">
                <span style="font-size:0.75rem; color:var(--on-surface-variant); display:block; margin-bottom:0.35rem;"><%= train.duration %></span>
                <div style="display:flex; align-items:center; gap:0.5rem;">
                  <div style="flex:1; height:2px; background:rgba(195,198,213,0.5);"></div>
                  <span class="material-symbols-outlined" style="color:var(--primary); font-size:18px;">train</span>
                  <div style="flex:1; height:2px; background:rgba(195,198,213,0.5);"></div>
                </div>
                <span style="font-size:0.65rem; color:var(--tertiary); font-weight:700; text-transform:uppercase; display:block; margin-top:0.3rem;">Direct</span>
              </div>
              <div style="text-align:right;">
                <span style="font-family:'Public Sans',sans-serif; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--on-surface-variant); display:block; margin-bottom:0.2rem;">Arrival</span>
                <span class="font-headline" style="font-size:1.75rem; font-weight:700; color:var(--on-surface);"><%= train.arrivalTime %></span>
                <span style="font-size:0.75rem; color:var(--on-surface-variant); display:block;"><%= train.toStation %> (<%= train.toCode %>)</span>
              </div>
            </div>

            <!-- Classes & Book Button -->
            <div style="display:grid; grid-template-columns:repeat(<%= Math.min(train.classes.length, 3) %>, 1fr) auto; gap:0.75rem; align-items:stretch;">
              <% train.classes.slice(0,3).forEach(cls => { 
                  let seatStatus = 'waitlist';
                  if (cls.availableSeats > 10) seatStatus = 'available';
                  else if (cls.availableSeats > 0) seatStatus = 'low';
              %>
              <div style="background:var(--surface-container-lowest); padding:0.875rem; border-radius:10px; transition:background 0.2s;" onmouseover="this.style.background='var(--surface-container)'" onmouseout="this.style.background='var(--surface-container-lowest)'">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.35rem;">
                  <span style="font-weight:700; font-size:0.875rem; color:var(--on-surface);"><%= cls.className %></span>
                  <span style="font-family:'Public Sans',sans-serif; font-size:0.75rem; font-weight:700; color:var(--primary);">₹<%= cls.price %></span>
                </div>
                <div style="display:flex; align-items:center; gap:0.4rem;">
                  <span class="seat-dot <%= seatStatus %>"></span>
                  <span class="seat-status-text <%= seatStatus %>" style="font-size:0.68rem; font-weight:700;">
                    <%= cls.availableSeats > 0 ? 'Avail ' + cls.availableSeats : 'Waitlist' %>
                  </span>
                </div>
              </div>
              <% }) %>
              <a href="/trains/<%= train._id %>?date=<%= query.date || '' %>" class="btn-primary" style="white-space:nowrap; text-decoration:none; justify-content:center; border-radius:10px; align-self:stretch; display:flex; align-items:center;">
                Select Train <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
              </a>
            </div>
          </div>
          <% }) %>
        <% } %>
      </section>
    </div>
  </main>
</div>
</body>
</html>
